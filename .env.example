# Choose: groq, gemini, or openai
LLM_PROVIDER=groq

# Used when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Optionally use authorized keys from separate accounts in the live app and probe:
# GROQ_API_KEYS=key_from_account_1,key_from_account_2,key_from_account_3
GROQ_MODEL=openai/gpt-oss-20b
GROQ_RPM_LIMIT=150
GROQ_SESSION_REQUEST_LIMIT=500

# Used when LLM_PROVIDER=gemini (GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Used when LLM_PROVIDER=openai (ChatGPT API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
